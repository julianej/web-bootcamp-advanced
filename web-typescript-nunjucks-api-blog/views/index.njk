{% extends "layouts/base.njk" %}

{% block title %}Home | Clean Blog{% endblock %}

{% block content %}

<header>
  <h1>Blog Entries</h1>
</header>

<section class="posts">

  {% for post in posts %}

    <article class="post-preview">
      <a href="/posts/{{ post.slug }}">
        <h2>{{ post.title }}</h2>
        <h3>{{ post.teaser }}</h3>
      </a>

      <p>
        Posted by {{ post.author }} on {{ post.date }}
      </p>
    </article>

  {% else %}

    <p>No blog posts found.</p>

  {% endfor %}

</section>

{% endblock %}