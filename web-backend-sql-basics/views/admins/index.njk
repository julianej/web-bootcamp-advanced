{% extends "layouts/base.njk" %}

{% block content %}

<div class="container px-4 px-lg-5">

  <h1>Admin Dashboard</h1>

  {% for post in posts %}
    <article>
      <h2>{{ post.title }}</h2>

      <a href="/admin/edit/{{ loop.index0 }}">
        Edit
      </a>

      <form action="/admin/delete/{{ loop.index0 }}" method="POST">
        <button type="submit">Delete</button>
      </form>
    </article>
  {% endfor %}

</div>

{% endblock %}