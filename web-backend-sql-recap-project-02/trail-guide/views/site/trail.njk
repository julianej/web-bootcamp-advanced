
{% extends "templates/layouts/base.njk" %}

{% block main_content %}
    <a href="/home" class="back-link">
      ← Back to trails
    </a>
<section class="trail-detail">
  <!-- HEADER -->
  <header class="trail-detail__header">
    <p class="trail-detail__region eyebrow">
      {{ trail.region_name }}, {{ trail.country }}
    </p>

    <h1 class="trail-detail__title">
      {{ trail.name }}
    </h1>

    <span class="trail-card__difficulty trail-card__difficulty--{{ trail.difficulty }}">
      {{ trail.difficulty }}
    </span>

  </header>

  <!-- IMAGE -->
  <div class="trail-detail__image">
    {% if trail.image %}
      <img src="{{ trail.image }}" alt="{{ trail.name }}">
    {% else %}
      <div class="trail-detail__image-placeholder">
        No image available
      </div>
    {% endif %}
  </div>

  <!-- DETAILS -->
  <div class="trail-detail__content">

    <!-- STATS -->
    <div class="trail-detail__stats">

      <div class="trail-detail__stat">
        <span class="trail-detail__label">DISTANCE</span>
        <strong>{{ trail.distance_km }} km</strong>
      </div>

      <div class="trail-detail__stat">
        <span class="trail-detail__label">ELEVATION</span>
        <strong>{{ trail.elevation_m }} m</strong>
      </div>

      <div class="trail-detail__stat">
        <span class="trail-detail__label">DIFFICULTY</span>
        <strong>{{ trail.difficulty }}</strong>
      </div>

    </div>

    <!-- DESCRIPTION -->
    <div class="trail-detail__description">

      <p class="trail-detail__eyebrow">
        ABOUT THIS TRAIL
      </p>

      <p>{{ trail.description }}</p>

    </div>

    <!-- CREATED DATE -->
    <footer class="trail-detail__footer">

      <span>ADDED TO TRAIL GUIDE</span>

     <time datetime="{{ trail.created_at }}">
        {{ formattedDate }}
        </time>

    </footer>

  </div>
</section>

<section class="regions-section">

  <div class="container">
    <header class="section-heading">
      <h1>{{ region.name }}</h1>
      <p>{{ region.country }}</p>
    </header>

    {% if trails.length %}

      <div class="trail-list">

        <div class="trail-list__header">
          <span>View</span>
          <span>Trail</span>
          <span>Elevation</span>
          <span>Distance</span>
          <span>Difficulty</span>
          <span></span>
        </div>

        {% for trail in trails %}

          <a href="/trail/{{ trail.slug }}" class="trail-list__item">

            <span class="trail-list__image">
              <img src="{{ trail.image }}" alt="{{ trail.name }}">
            </span>

            <span class="trail-list__name">
              {{ trail.name }}
            </span>

            <span class="trail-list__elevation">
              {{ trail.elevation_m }} m
            </span>

            <span class="trail-list__distance">
              {{ trail.distance_km }} km
            </span>

            <span class="trail-list__difficulty trail-list__difficulty--{{ trail.difficulty }}">
              {{ trail.difficulty | capitalize }}
            </span>

            <span class="trail-list__arrow">↗</span>

          </a>

        {% endfor %}

      </div>

    {% else %}

      <p class="empty-state">No trails available yet.</p>

    {% endif %}

  </div>

</section>

{% endblock %}
