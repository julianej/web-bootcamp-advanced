
{% extends "templates/layouts/base.njk" %}

{% block title %}Trail Guide — Discover Your Next Trail{% endblock %}

{% block main_content %}

  {% include "templates/components/hero.njk" %}

  <!-- ABOUT-->
  {% include "templates/components/about.njk" %}

  <!-- TRAILS -->
  <section class="trails-section" id="trails">

    <div class="container">

      <div class="section-heading">
        <p class="eyebrow">03 — DISCOVER</p>
        <h2>FIND YOUR TRAIL.</h2>
      </div>

      <p class="trails-count">
        <span class="trails-count__number">{{ trails.length }}</span>
        <span class="trails-count__label">Trails to explore</span>
      </p>

      {% if trails and trails.length > 0 %}

        <div class="trails-grid">

            {% from "templates/macros/trailcard.njk" import trailCard %}

            {% for trail in trails %}
              {{ trailCard(trail) }}
            {% endfor %}

          </div>

      {% else %}

        <p>No trails available yet.</p>

      {% endif %}

    </div>

  </section>

{% endblock %}
