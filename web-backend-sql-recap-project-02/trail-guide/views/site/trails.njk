
{% extends "templates/layouts/base.njk" %}

{% block main_content %}
    <a href="/home" class="back-link">
      ← Back to Home
    </a>
<section class="trails-page">

  <header class="trails-page__header">
    <p class="trails-page__eyebrow">TRAIL GUIDE</p>
    <h1>Explore Trails</h1>
    <p>Discover your next adventure.</p>
  </header>

  <div class="trails-grid">

    {% for trail in trails %}

      <article class="trail-card">

        <a href="/trail/{{ trail.slug }}" class="trail-card__link">

          <div class="trail-card__image">
            <img
              src="{{ trail.image }}"
              alt="{{ trail.name }}"
            >
          </div>

          <div class="trail-card__content">

            <p class="trail-card__region">
              {{ trail.region_name }}, {{ trail.region_country }}
            </p>

            <h4 class="trail-card__title">
              {{ trail.name }}
            </h4>

            <span class="trail-card__difficulty trail-card__difficulty--{{ trail.difficulty }}">
              {{ trail.difficulty }}
            </span>

            <div class="trail-card__stats">
              <span>{{ trail.distance_km }} km</span>
              <span>{{ trail.elevation_m }} m elevation</span>
            </div>

          </div>

        </a>

      </article>

    {% else %}

      <p>No trails available yet.</p>

    {% endfor %}

  </div>

</section>

{% endblock %}
