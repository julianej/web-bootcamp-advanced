{% extends "templates/layouts/base.njk" %}
{% from "templates/macros/regionCard.njk" import regionCard %}

{% block main_content %}

<section class="regions-section">
<a href="/home" class="back-link">
  ← Back to Home
</a>
  <div class="container">

    <header class="section-heading">
      <p class="eyebrow">DISCOVER</p>
      <h1>Explore Regions</h1>
    </header>

    {% if regions and regions.length > 0 %}

      <div class="regions-grid">

        {% for region in regions %}
          {{ regionCard(region) }}
        {% endfor %}

      </div>

    {% else %}

      <p>No regions available yet.</p>

    {% endif %}

  </div>

</section>

{% endblock %}
