
{% from "../macros/searchFilter.njk" import searchFilter %}

{% set pathPrefix = '' if currentPage == 'home' else '/' %}

<nav class="navigation">

  <div class="navigation__main">

    <a href="/" class="navigation__logo">
      TRAILGUIDE<span>.</span>
    </a>

    <div class="navigation__links">
      <a href="{{ pathPrefix }}#trails">Explore Trails</a>
      <a href="{{ pathPrefix }}#regions">Explore Regions</a>
      <a href="{{ pathPrefix }}#about">About</a>
      <a href="{{ pathPrefix }}#contact" class="navigation__cta">
        Get in touch ↗
      </a>
    </div>

    {% if showFilters %}
      <button
        class="navigation__toggle"
        type="button"
        aria-label="Toggle trail filters"
        aria-expanded="false"
        aria-controls="navigation-filters"
      >
        <span>Search Trail</span>
      </button>

    {% endif %}

  </div>

  {% if showFilters %}
    <div class="navigation__filters" id="navigation-filters">
      <div class="navigation__filters-inner">
        {{ searchFilter(q, regions, region, difficulty) }}
      </div>
    </div>
  {% endif %}

</nav>
