
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{% block title %}Trail Guide – Explore the outdoors{% endblock %}</title>

  <meta
    name="description"
    content="{% block description %}Discover hiking trails, explore regions and find your next outdoor adventure.{% endblock %}"
  >

  <link rel="stylesheet" href="/styles.css">

  {% block styles %}{% endblock %}
</head>

<body>

  {# Navigation #}
  {% include "templates/components/navigation.njk" %}

  {# Main page content #}
  <main id="main-content">

    {# Optional page header #}
    {% block page_header %}{% endblock %}

    {# Individual page content #}
    {% block main_content %}{% endblock %}

    {# Optional pagination #}
    {% block pagination %}{% endblock %}

  </main>

  {# Footer #}
  {% include "templates/components/footer.njk" %}

  {# Page-specific scripts #}
  <script src="/js/filter.js" defer></script>

  {% block scripts %}{% endblock %}

</body>
</html>
