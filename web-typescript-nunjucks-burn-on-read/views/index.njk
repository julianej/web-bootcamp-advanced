{% extends "layouts/base.njk" %}

{% block title %}Create a Secret Message{% endblock %}

{% block content %}
  <h1>Burn on Read</h1>
  <p>Write a message. Share the link. It can only be opened once.</p>

  <form action="/messages" method="POST">
    <label for="message">Your secret message</label>
    <textarea
      id="message"
      name="message"
      placeholder="Write your message..."
      required
    ></textarea>

    <button type="submit">Create one-time link</button>
  </form>
{% endblock %}