{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",   // COURSE RELATED
    "outDir": "./dist",   // COURSE RELATED

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext", // "nodenext"   // COURSE RELATED
    "target": "esnext",   // COURSE RELATED
    "lib": ["esnext"],
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": false, // true
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,   // COURSE RELATED
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true, // COURSE RELATED
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
   // COURSE RELATED
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
